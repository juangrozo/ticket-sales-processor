{
  "info": {
    "name": "Ticket Sales Processor",
    "description": "Main flows of the ticketing API, with assertions. Run against `docker compose up`: in Postman, or with `docker run --rm --network host -v \"$PWD/postman:/etc/newman\" postman/newman:6.1.3-alpine run ticket-sales-processor.postman_collection.json`. Requests that read the result of asynchronous processing wait 1.5 s first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminKey",
      "value": "local-admin-key"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "declinedOrderId",
      "value": ""
    },
    {
      "key": "soldOutOrderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Events",
      "item": [
        {
          "name": "Create event (3 tickets)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rock Fest\",\n  \"venue\": \"Movistar Arena\",\n  \"startsAt\": \"2027-12-15T20:00:00Z\",\n  \"capacity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique ids per run, so the collection can be run many times against the same stack",
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"eventId\", body.eventId);",
                  "pm.test(\"Full inventory available\", () => pm.expect(body.inventory.available).to.eql(3));",
                  "pm.test(\"Location header\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/events/\" + body.eventId));"
                ]
              }
            }
          ]
        },
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Contains the new event\", () => pm.expect(pm.response.json().map(e => e.eventId)).to.include(pm.collectionVariables.get(\"eventId\")));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Purchase and idempotency",
      "item": [
        {
          "name": "Place order (2 tickets)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Customer-Id",
                "value": "ana-{{runId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "purchase-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted: stored and queued, not processed yet\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", body.orderId);",
                  "pm.test(\"Order is PENDING\", () => pm.expect(body.orderStatus).to.eql(\"PENDING\"));",
                  "pm.test(\"No tickets yet\", () => pm.expect(body.ticketStatus).to.be.oneOf([null, undefined]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat the same request (same key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Customer-Id",
                "value": "ana-{{runId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "purchase-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Same order, no duplicate\", () => pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get(\"orderId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Customer-Id",
                "value": "ana-{{runId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "purchase-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Content\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Problem details\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order: tickets reserved",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "ana-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 1500); // the worker processes the message asynchronously"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Reserved by the worker\", () => pm.expect(body.orderStatus).to.eql(\"AWAITING_CONFIRMATION\"));",
                  "pm.test(\"Tickets RESERVED\", () => pm.expect(body.ticketStatus).to.eql(\"RESERVED\"));",
                  "pm.test(\"Two tickets\", () => pm.expect(body.tickets.length).to.eql(2));",
                  "pm.test(\"Reservation has a deadline\", () => pm.expect(body.expiresAt).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order as another customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "intruder-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404: another customer's order looks missing\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Availability counts the reservation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"1 available\", () => pm.expect(body.available).to.eql(1));",
                  "pm.test(\"2 reserved\", () => pm.expect(body.reserved).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "ana-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "confirm"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted: payment runs in the worker\", () => pm.response.to.have.status(202));",
                  "pm.test(\"CONFIRMING\", () => pm.expect(pm.response.json().orderStatus).to.eql(\"CONFIRMING\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order: sold",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "ana-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 1500); // the worker processes the message asynchronously"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"CONFIRMED\", () => pm.expect(body.orderStatus).to.eql(\"CONFIRMED\"));",
                  "pm.test(\"Tickets SOLD\", () => pm.expect(body.ticketStatus).to.eql(\"SOLD\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Declined payment and sold out",
      "item": [
        {
          "name": "Place order (customer whose payment is declined)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Customer-Id",
                "value": "declined-bob-{{runId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "declined-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set(\"declinedOrderId\", pm.response.json().orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm declined order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "declined-bob-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{declinedOrderId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{declinedOrderId}}",
                "confirm"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 1500); // the worker processes the message asynchronously"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get declined order: tickets released",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "declined-bob-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{declinedOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{declinedOrderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 1500); // the worker processes the message asynchronously"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"REJECTED\", () => pm.expect(body.orderStatus).to.eql(\"REJECTED\"));",
                  "pm.test(\"Tickets back to AVAILABLE\", () => pm.expect(body.ticketStatus).to.eql(\"AVAILABLE\"));",
                  "pm.test(\"Reason recorded\", () => pm.expect(body.failureReason).to.include(\"declined\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Place order for more tickets than left",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Customer-Id",
                "value": "carl-{{runId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "sold-out-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted: the API never checks stock itself\", () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set(\"soldOutOrderId\", pm.response.json().orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order: rejected for lack of stock",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "carl-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{soldOutOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{soldOutOrderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 1500); // the worker processes the message asynchronously"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"REJECTED\", () => pm.expect(body.orderStatus).to.eql(\"REJECTED\"));",
                  "pm.test(\"Insufficient inventory\", () => pm.expect(body.failureReason).to.eql(\"Insufficient inventory\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Complimentary and reports",
      "item": [
        {
          "name": "Complimentary with a wrong admin key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Key",
                "value": "wrong-key"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/complimentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "complimentary"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"vip-1\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 Forbidden\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Grant a complimentary ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/complimentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "complimentary"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"vip-1\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"COMPLIMENTARY order\", () => pm.expect(body.type).to.eql(\"COMPLIMENTARY\"));",
                  "pm.test(\"Final from the start\", () => pm.expect(body.orderStatus).to.eql(\"CONFIRMED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Report: complimentary is not a sale",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "report"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Accounting counts only the 2 sold\", () => pm.expect(body.accounting.soldTickets).to.eql(2));",
                  "pm.test(\"Inventory shows the complimentary\", () => pm.expect(body.inventory.complimentary).to.eql(1));",
                  "pm.test(\"Every ticket accounted for\", () => pm.expect(body.inventory.total).to.eql(3));",
                  "pm.test(\"Sold out\", () => pm.expect(body.operational.available).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Errors",
      "item": [
        {
          "name": "Order without customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "anonymous-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order for more than 10 tickets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Customer-Id",
                "value": "dan-{{runId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "too-many-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
